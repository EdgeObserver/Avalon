# 复制为 .env 后填入你自己的 key
# 本项目默认走 OpenCode Go（OpenAI 兼容端点）
# 本地 Ollama 不需要任何 key，只需确认 `ollama serve` 在运行

# OpenCode Go / OpenCode 的 API key（在 opencode.ai/console 里生成）
OPENCODE_API_KEY=
# 可选：覆盖端点，默认 https://opencode.ai/zen/go/v1
# OPENCODE_BASE_URL=
# 可选：覆盖模型，默认 deepseek-v4.1-flash
# AVALON_MODEL=

# 其他后端的 key（暂时用不到）
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
